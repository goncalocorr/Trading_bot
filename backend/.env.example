BINANCE_API_KEY=
BINANCE_SECRET=
BINANCE_TESTNET=true
BINANCE_TESTNET_BASE_URL=https://testnet.binance.vision
TRADING_MODE=paper
# Autonomy modes: manual (no auto-trading), supervised_auto (auto in paper, manual approve for live), full_auto (fully autonomous).
# Use supervised_auto for VPS paper testing. Switch to full_auto only after approving a champion for live.
AUTONOMY_MODE=supervised_auto
SHADOW_MODE_ENABLED=false
# Enable heartbeat to receive daily Telegram summary of bot status.
AUTONOMY_HEARTBEAT_ENABLED=true
AUTO_SWAP_ENABLED=false
AUTO_APPROVE_LIVE_ENABLED=false
AUTO_LIVE_DEPLOY_ENABLED=false
# Set to false on VPS to prevent boot loops when exchange is temporarily down.
STARTUP_STRICT_MODE=false

WEBHOOK_SECRET=
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SECRET=
NODE_ENV=production
# CORS origin for frontend (e.g. https://yourdomain.com). Leave empty or * for development.
CORS_ORIGIN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFICATION_LOCALE=en
TELEGRAM_NEAR_READY_COOLDOWN_MINUTES=90
TELEGRAM_READY_COOLDOWN_MINUTES=30

CRYPTOPANIC_API_KEY=
FEAR_GREED_API_URL=https://api.alternative.me/fng/
ECONOMIC_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json

# Use "mysql" as DB_HOST when running with Docker Compose, "localhost" for local dev.
DB_HOST=localhost
DB_PORT=3306
DB_USER=tradingbot
DB_PASSWORD=
DB_NAME=tradingbot

TRADING_PAIRS=BTCUSDT
ACTIVE_STRATEGIES=multi_timeframe_rsi,pullback_continuation,mean_reversion
CHAMPION_RUN_ID=
CHALLENGER_RUN_ID=
REGIME_CHAMPION_TREND_RUN_ID=
REGIME_CHAMPION_SIDEWAYS_RUN_ID=
REGIME_CHAMPION_VOLATILE_RUN_ID=
APPROVED_LIVE_RUN_ID=
# Signal execution threshold (0-12). Lower = more trades, lower selectivity.
# 7 = good balance for paper testing and small capital. 8 = high quality for live with larger capital.
SCORE_THRESHOLD=7
RISK_PER_TRADE=0.01
COMPOUND_RATIO=0.5
DAILY_DRAWDOWN_LIMIT=0.05
MAX_OPEN_TRADES=3
MAX_OPEN_TRADES_PER_PAIR=1
PAIR_COOLDOWN_MINUTES=30
# Trading hours filter (UTC). Set TRADING_HOURS_ENABLED=true to restrict signals to a time window.
TRADING_HOURS_ENABLED=false
TRADING_HOURS_START_UTC=7
TRADING_HOURS_END_UTC=21

# Trailing stop after break-even is activated.
TRAILING_STOP_ENABLED=true
TRAILING_STOP_MULTIPLIER=1.0

# Slippage buffer applied to position sizing (percentage).
SLIPPAGE_BUFFER_PERCENT=0.1

# Strategy-specific exit levels (ATR multiples).
EXIT_DEFAULT_STOP_ATR=1.5
EXIT_DEFAULT_TP_ATR=3.0
EXIT_MEAN_REVERSION_STOP_ATR=1.0
EXIT_MEAN_REVERSION_TP_ATR=2.0
EXIT_PULLBACK_STOP_ATR=1.5
EXIT_PULLBACK_TP_ATR=3.5
EXIT_MTF_RSI_STOP_ATR=1.5
EXIT_MTF_RSI_TP_ATR=3.0

# Strategy-specific RSI thresholds.
MEAN_REVERSION_RSI_OVERSOLD=30
MEAN_REVERSION_RSI_OVERBOUGHT=70
MTF_RSI_BUY_THRESHOLD=35
MTF_RSI_SELL_THRESHOLD=65
PULLBACK_ATR_FLOOR_MULT=0.75
PULLBACK_CEILING_MULT=1.02
PULLBACK_RSI_MIN=35
PULLBACK_RSI_MAX=65

# Auto scan concurrency (number of pairs scanned in parallel).
AUTO_SCAN_CONCURRENCY=3

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# Minimum ATR% to consider a market tradeable. 0.25 = permissive (more signals).
# 0.4-0.5 = higher quality entries, fewer low-volatility false signals.
MIN_ATR_PERCENT=0.25
# Minimum EMA spread% before market is considered sideways/compressed.
EMA_COMPRESSION_THRESHOLD_PERCENT=0.15
BACKTEST_FEE_RATE=0.001
BACKTEST_SLIPPAGE_BPS=5
WALK_FORWARD_TRAIN_DAYS=30
WALK_FORWARD_TEST_DAYS=7
WALK_FORWARD_STEP_DAYS=7
STRATEGY_HEALTH_LOOKBACK=8
STRATEGY_HEALTH_MIN_WIN_RATE=35
STRATEGY_HEALTH_MIN_PNL=-1
PAPER_APPROVAL_MIN_TRADES=8
PAPER_APPROVAL_MIN_WIN_RATE=45
PAPER_APPROVAL_MIN_PNL=0
PAPER_DEMOTION_MIN_TRADES=5
PAPER_DEMOTION_MIN_WIN_RATE=30
PAPER_DEMOTION_MIN_PNL=-1
PAPER_CHALLENGER_MIN_TRADES=5
PAPER_CHALLENGER_MIN_EDGE_PNL=0.5
PAPER_CHALLENGER_MIN_EDGE_WIN_RATE=5
ALLOCATION_TREND_MULTIPLIER=1
ALLOCATION_SIDEWAYS_MULTIPLIER=0.5
ALLOCATION_VOLATILE_MULTIPLIER=0.75
ALLOCATION_MIXED_MULTIPLIER=0.75
ALLOCATION_TREND_MAX_EXPOSURE=1
ALLOCATION_SIDEWAYS_MAX_EXPOSURE=0.5
ALLOCATION_VOLATILE_MAX_EXPOSURE=0.75
ALLOCATION_MIXED_MAX_EXPOSURE=0.6
CIRCUIT_BREAKER_MAX_EXECUTION_FAILURES=3
CIRCUIT_BREAKER_MAX_EXCHANGE_FAILURES=3
CIRCUIT_BREAKER_AUTO_RESET_MINUTES=30
EXPERIMENT_MAX_DRAWDOWN=15
EXPERIMENT_MIN_RETURN=2
EXPERIMENT_MIN_WIN_RATE=40

PORT=3000
FRONTEND_PORT=5173
INITIAL_CAPITAL=100
