# Docker Compose environment variables.
# Copy this to .env and fill in secure values before deploying.

# MySQL root password (used by docker-compose only).
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_random_password_here

# Database credentials (must match backend/.env DB_USER and DB_PASSWORD).
DB_USER=tradingbot
DB_PASSWORD=CHANGE_ME_another_strong_password
DB_NAME=tradingbot

# Domain for SSL certificate (used by certbot).
DOMAIN=your-domain.com
